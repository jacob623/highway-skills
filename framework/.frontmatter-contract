# Frontmatter contract manifest for schema-validate.sh / validate-skill.sh.
# The fields and limits follow the Agent Skills specification (https://agentskills.io/specification).
# Format: scope<TAB>key<TAB>required<TAB>constraint
#   scope:      "top" (top-level frontmatter key) or "metadata" (nested under metadata:)
#   key:        the frontmatter key name
#   required:   "yes" or "no"
#   constraint: "-" (no constraint), "kebab-case", "length:MIN-MAX", "enum:v1,v2,...", or "semver"
# Lines starting with # and blank lines are ignored.
top	name	yes	kebab-case
top	description	yes	length:1-1024
top	license	yes	-
top	compatibility	no	length:1-500
top	allowed-tools	no	-
metadata	version	yes	semver
metadata	usage	yes	length:1-500
